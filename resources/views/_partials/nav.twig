{% set navItems = [
    {
        title: 'Blog',
        url: '/blog',
        active: entry and (entry.slug == 'blog' or entry.section.handle == 'blog'),
        external: false,
    },
    {
        title: 'Contact',
        url: '/contact',
        active: entry and entry.slug == 'contact',
        external: false,
    },
] %}

{% for item in navItems %}
    <a
        {% if item.external %}target="_blank" rel="noopener"{% endif %}
        href="{{ item.url }}"
        class="{{ loop.last ? '' : 'mr-6' }} hover:text-orange-500 text-lg no-underline no-shadow hidden sm:block {{ item.active ? 'text-orange-500' : 'text-gray-600' }}"
    >
        {{ item.title }}
    </a>
{% endfor %}
